# Copy this file to backend/.env and fill in only the values after =.
# Do not use quotes. Restart the API server after editing.
# OpenAI project API key (server only).
OPENAI_API_KEY=
# YouTube Data API v3 key. Enable this API in Google Cloud and restrict the key to it.
YOUTUBE_API_KEY=

# 영상 분석용 Google AI Studio API 키. 설정 후 백엔드를 재시작하세요.
GEMINI_API_KEY=
# 영상 분석 모델과 지침은 AI 설정 화면에서 관리합니다.
